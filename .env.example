# Copier ce fichier en .env puis renseigner votre cle LLM. NE JAMAIS committer .env.

# --- LLM (free tier cloud) -------------------------------------------------
# Provider : groq (recommande, rapide) ou gemini
LLM_PROVIDER=groq
# Groq : https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Google Gemini : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Vector store (projet A = Qdrant) --------------------------------------
VECTOR_STORE=qdrant
# En local : http://localhost:6333  -  dans docker-compose : http://qdrant:6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=assistkb

# --- Embeddings (local) ----------------------------------------------------
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIM=384

# --- Retrieval -------------------------------------------------------------
TOP_K=5
# Seuil de similarite cosinus : sous ce score, on REFUSE de repondre (anti-hallucination)
# 0.45 = compromis retenu apres experimentation (cf. compte rendu R3)
SIMILARITY_THRESHOLD=0.45

# --- Ingestion / chunking --------------------------------------------------
# Dossiers scannes (seed committe + raw telecharge par fetch_corpus)
CORPUS_DIRS=socle-commun/corpus/seed,corpus/raw
CHUNKS_PATH=corpus/chunks.jsonl
CHUNK_SIZE=800
CHUNK_OVERLAP=120
